{
  "host": "localhost",
  "port": 3030,
  "public": "../public/",
  "paginate": {
    "default": 10,
    "max": 50
  },
  "authentication": {
    "secret": "INSECURE_DEV_SECRET_DO_NOT_USE_IN_PRODUCTION_set_SECRET_TOKEN_env_var",
    "entity": "user",
    "service": "users",
    "authStrategies": ["jwt", "local"],
    "jwtOptions": {
      "audience": "https://localhost:3030",
      "header": {
        "typ": "access"
      },
      "issuer": "feathers",
      "algorithm": "HS256",
      "expiresIn": "1d"
    },
    "local": {
      "usernameField": "email",
      "passwordField": "password",
      "errorMessage": "Invalid login"
    }
  },
  "features": {
    "emailCampaigns": "FEATURE_EMAIL_CAMPAIGNS",
    "runJobsFromAdminUi": "FEATURE_RUN_JOBS_FROM_ADMIN_UI"
  },
  "mailer": {
    "nodemailerOptions": {
      "message": {
        "from": "SENDER_EMAIL",
        "replyTo": "REPLY_TO_EMAIL"
      },
      "send": true,
      "preview": false
    },
    "etherealTransport": {
      "host": "smtp.ethereal.email",
      "port": 587,
      "secure": false,
      "auth": {
        "user": "ETHEREAL_EMAIL",
        "pass": "ETHEREAL_PASSWORD"
      }
    },
    "postmarkTransport": {
      "auth": {
        "apiKey": "POSTMARK_API_KEY"
      }
    },
    "postmarkSandboxTransport": {
      "auth": {
        "apiKey": "POSTMARK_SANDBOX_API_KEY"
      }
    },
    "transport": "EMAIL_TRANSPORT",
    "auditRecipients": "AUDIT_RECIPIENTS"
  },
  "search": {
    "apiKey": "GEOCODER_API_KEY"
  },
  "postgres": {
    "client": "pg",
    "connection": "postgresql://teikei:teikei@localhost:5432/teikei"
  },
  "errorhandler": {
    "html": false
  },
  "enableJobScheduler": true,
  "corsOrigins": "http://localhost:3000,http://localhost:4000,http://localhost:4173",
  "trustProxy": false,
  "rateLimit": {
    "enabled": true,
    "auth": { "windowMs": 900000, "max": 20 },
    "passwordReset": { "windowMs": 3600000, "max": 10 },
    "register": { "windowMs": 3600000, "max": 10 },
    "contact": { "windowMs": 3600000, "max": 10 }
  }
}
