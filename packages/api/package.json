{
  "name": "@teikei/api",
  "description": "Teikei API server. Teikei is the software that powers ernte-teilen.org, a website that maps out Community-supported Agriculture in Germany.",
  "version": "1.0.0",
  "homepage": "",
  "main": "src",
  "keywords": [
    "csa",
    "farming",
    "agriculture"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/teikei/teikei"
  },
  "author": "Simon Jockers, Daniel Mack, Tobias Preuß, Christian Rijke",
  "license": "AGPL-3.0",
  "contributors": [],
  "bugs": {
    "url": "https://github.com/teikei/teikei/issues"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "directories": {
    "lib": "src",
    "test": "test/"
  },
  "scripts": {
    "test": "NODE_ENV=test vitest run",
    "integration-test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "clean": "rm -rf build && mkdir build",
    "build": "npx babel -d ./build -D ./src",
    "start": "node ./build/index.js",
    "dev": "babel-watch --watch src/templates src/index.js",
    "dev-db": "run-p dev-db-startdocker dev-db-initdb",
    "dev-db-startdocker": "docker build -t teikei-environment ./db && docker run --rm -p 5432:5432 teikei-environment",
    "dev-db-initdb": "node scripts/wait-for-db.js && npm run migrate:latest && npm run seed:run",
    "dev-debug": "DEBUG=* babel-watch src/index.js",
    "mocha": "mocha test/ --recursive --exit",
    "migrate:latest": "npx knex --knexfile db/knexfile.js migrate:latest",
    "migrate:make": "npx knex migrate:make  --migrations-directory ./db/migrations",
    "seed:run": "cd db && npx knex seed:run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@feathersjs/authentication": "^5.0.44",
    "@feathersjs/authentication-local": "^5.0.44",
    "@feathersjs/configuration": "^5.0.44",
    "@feathersjs/errors": "^5.0.44",
    "@feathersjs/express": "^5.0.44",
    "@feathersjs/feathers": "^5.0.44",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "caniuse-lite": "^1.0.30001793",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dockerode": "^5.0.0",
    "dotenv": "^17.4.2",
    "email-templates": "^13.0.1",
    "express-basic-auth": "^1.2.1",
    "express-rate-limit": "^8.5.2",
    "feathers-authentication-management": "^5.1.0",
    "feathers-envhelpers": "^0.6.2",
    "feathers-hooks-common": "^8.2.1",
    "feathers-objection": "7.6.0",
    "geojson": "^0.5.0",
    "glob": "^13.0.6",
    "helmet": "^8.1.0",
    "inky": "^1.5.0",
    "joi": "^18.2.1",
    "jwt-decode": "^4.0.0",
    "knex": "^3.2.10",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "node-schedule": "^2.1.1",
    "nodemailer": "^8.0.7",
    "nodemailer-postmark-transport": "^6.0.1",
    "nodemailer-sparkpost-transport": "^2.2.0",
    "nunjucks": "^3.2.4",
    "objection": "^3.1.5",
    "objection-db-errors": "^1.1.2",
    "passport-jwt": "^4.0.1",
    "pg": "^8.21.0",
    "preview-email": "^3.1.3",
    "serve-favicon": "^2.5.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/node": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@faker-js/faker": "^9.2.0",
    "babel-watch": "^7.8.1",
    "knex-db-manager": "^0.7.0",
    "pg-connection-string": "^2.13.0",
    "pg-escape": "^0.2.0",
    "request": "^2.88.2",
    "request-promise": "^4.2.6",
    "testcontainers": "^12.0.0",
    "uuid": "^11.0.3",
    "vitest": "^4.1.10",
    "watchman": "^1.0.0",
    "webpack": "^5.104.1"
  }
}
