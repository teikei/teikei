{
	"name": "embed",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run build:embed && npm run build:widgets",
		"build:embed": "vite build && node scripts/build-embed.js",
		"build:widgets": "node scripts/build-widgets.js",
		"preview": "vite preview",
		"preview:embed": "cd build && serve . -p 3000",
		"preview:widgets": "vite preview --config vite.widget.config.ts",
		"clean": "rm -rf build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"engines": {
		"node": "24.x",
		"npm": "11.x"
	},
	"dependencies": {
		"@lucide/svelte": "^1.17.0",
		"@versatiles/style": "^5.12.0",
		"bits-ui": "^2.18.1",
		"chroma-js": "^3.2.0",
		"formsnap": "^2.0.1",
		"maplibre-gl": "^5.24.0",
		"svelte-maplibre": "^1.3.0",
		"sveltekit-superforms": "^2.30.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource/fira-mono": "^5.2.7",
		"@inlang/paraglide-js": "^2.18.1",
		"@internationalized/date": "^3.12.1",
		"@neoconfetti/svelte": "^2.2.2",
		"@playwright/test": "^1.60.0",
		"@storybook/addon-docs": "^10.4.0",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-themes": "^10.4.0",
		"@storybook/sveltekit": "^10.4.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/dom": "^10.4.1",
		"@types/node": "^25",
		"@vitest/browser-playwright": "^4.1.7",
		"clsx": "^2.1.1",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"serve": "^14.2.6",
		"shadcn-svelte": "^1.3.0",
		"storybook": "^10.4.0",
		"svelte": "^5.55.9",
		"svelte-check": "^4.4.8",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.4",
		"vite": "^8.0.13",
		"vitest": "^4.1.7",
		"vitest-browser-svelte": "^2.1.1"
	}
}
