{
	"name": "map-next",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run build:embed && npm run build:widgets",
		"build:embed": "vite build && node scripts/build-embed.js",
		"build:widgets": "node scripts/build-widgets.js",
		"preview": "vite preview",
		"preview:embed": "cd build && npx serve . -p 3000",
		"preview:widgets": "vite preview --config vite.widget.config.ts",
		"clean": "rm -rf build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"engines": {
		"node": "24.x",
		"npm": "11.x"
	},
	"dependencies": {
		"@versatiles/style": "^5.8.4",
		"bits-ui": "^2.15.4",
		"chroma-js": "^3.2.0",
		"formsnap": "^2.0.1",
		"lucide-svelte": "^0.562.0",
		"maplibre-gl": "^5.16.0",
		"svelte-maplibre": "^1.2.5",
		"sveltekit-superforms": "^2.29.1",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.1",
		"@eslint/js": "^9.39.2",
		"@fontsource/fira-mono": "^5.2.7",
		"@inlang/paraglide-js": "^2.9.0",
		"@internationalized/date": "^3.10.1",
		"@lucide/svelte": "^0.562.0",
		"@neoconfetti/svelte": "^2.2.2",
		"@playwright/test": "^1.57.0",
		"@storybook/addon-docs": "^10.4.0",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-themes": "^10.4.0",
		"@storybook/sveltekit": "^10.4.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^25",
		"@vitest/browser-playwright": "^4.0.17",
		"clsx": "^2.1.1",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.0.0",
		"playwright": "^1.57.0",
		"prettier": "^3.8.0",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"storybook": "^10.4.0",
		"svelte": "^5.46.4",
		"svelte-check": "^4.3.5",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.53.0",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.0.17",
		"vitest-browser-svelte": "^2.0.1"
	}
}
