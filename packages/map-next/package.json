{
	"name": "map-next",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run build:embed && npm run build:widgets",
		"build:embed": "vite build && node scripts/build-embed.js",
		"build:widgets": "node scripts/build-widgets.js",
		"preview": "vite preview",
		"preview:embed": "cd build && npx serve . -p 3000",
		"preview:widgets": "vite preview --config vite.widget.config.ts",
		"clean": "rm -rf build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"engines": {
		"node": "24.x",
		"npm": "11.x"
	},
	"dependencies": {
		"@versatiles/style": "5.8.4",
		"bits-ui": "^2.16.4",
		"chroma-js": "^3.2.0",
		"formsnap": "^2.0.1",
		"lucide-svelte": "^1.0.1",
		"maplibre-gl": "^5.21.1",
		"svelte-maplibre": "^1.2.6",
		"sveltekit-superforms": "^2.30.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^9.39.2",
		"@fontsource/fira-mono": "^5.2.7",
		"@inlang/paraglide-js": "^2.15.1",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.7.0",
		"@neoconfetti/svelte": "^2.2.2",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25",
		"@vitest/browser-playwright": "^4.1.2",
		"clsx": "^2.1.1",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.16.0",
		"globals": "^17.4.0",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.0",
		"svelte-check": "^4.4.5",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.2",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.1.2",
		"vitest-browser-svelte": "^2.1.0"
	}
}
