{
	"name": "map",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run build:embed && npm run build:widgets",
		"build:embed": "vite build && node scripts/build-embed.js",
		"build:widgets": "node scripts/build-widgets.js",
		"preview:embed": "vite preview",
		"preview:widgets": "vite preview --config vite.widget.config.ts",
		"clean": "rm -rf build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.38.0",
		"@inlang/paraglide-js": "2.5.0",
		"@internationalized/date": "^3.10.0",
		"@lucide/svelte": "^0.553.0",
		"@playwright/test": "^1.56.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.47.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.14",
		"@types/node": "^22",
		"@vitest/browser": "^3.2.4",
		"bits-ui": "^2.14.2",
		"clsx": "^2.1.1",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"formsnap": "^2.0.1",
		"globals": "^16.4.0",
		"playwright": "^1.56.1",
		"svelte": "^5.41.0",
		"svelte-check": "^4.3.3",
		"sveltekit-superforms": "^2.28.1",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^3.1.1",
		"tailwindcss": "^4.1.14",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.1",
		"vite": "^7.1.10",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^3.2.4",
		"vitest-browser-svelte": "^1.1.0"
	},
	"dependencies": {
		"@versatiles/style": "^5.7.0",
		"maplibre-gl": "^5.11.0",
		"svelte-maplibre": "^1.2.5"
	}
}
