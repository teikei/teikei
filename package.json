{
  "name": "teikei",
  "version": "1.0.0",
  "description": "Teikei root monorepo. Teikei is the software that powers ernte-teilen.org, a website that maps out Community-supported Agriculture in Germany.",
  "main": "index.js",
  "repository": "https://github.com/teikei/teikei.git",
  "author": "Simon Jockers, Daniel Mack, Tobias Preuß, Christian Rijke",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-query": "^5.100.11",
    "@types/chroma-js": "^3.1.2",
    "@types/react-select": "^5.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lerna": "^9.0.7",
    "lint-staged": "^17.0.5",
    "npm-check-updates": "^22.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "prettier-config-standard": "^7.0.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "standard": "^17.1.2",
    "start-server-and-test": "^3.0.5",
    "svelte": "^5.55.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "optionalDependencies": {
    "@nx/nx-linux-x64-gnu": "^22.7.2"
  },
  "scripts": {
    "dev": "run-p dev-db-container dev-migrate-then-app",
    "dev-legacy": "run-p dev-db-container dev-migrate-then-legacy-app",
    "dev-no-db": "run-p dev-api dev-map-frontend",
    "dev-admin": "run-p dev-db-container dev-migrate-then-admin-app",
    "dev-admin-no-db": "run-p dev-api dev-admin-frontend",
    "dev-db": "run-p dev-db-container dev-db-init",
    "dev-db-container": "cd packages/api && npm run dev-db-startdocker",
    "dev-db-init": "cd packages/api && npm run dev-db-initdb",
    "dev-app": "run-p dev-api dev-map-frontend",
    "dev-legacy-app": "run-p dev-api dev-map-legacy-frontend",
    "dev-admin-app": "run-p dev-api dev-admin-frontend",
    "dev-migrate-then-app": "run-s dev-db-init dev-app",
    "dev-migrate-then-legacy-app": "run-s dev-db-init dev-legacy-app",
    "dev-migrate-then-admin-app": "run-s dev-db-init dev-admin-app",
    "dev-api": "cd packages/api && npm run dev",
    "dev-map-legacy-frontend": "cd packages/map && npm run dev | cat",
    "dev-map-frontend": "cd packages/map-next && npm run dev | cat",
    "dev-admin-frontend": "cd packages/admin && npm run dev",
    "build": "lerna exec -- npm run build",
    "start": "NODE_ENV=production run-p start-api start-map-frontend",
    "start-api": "cd packages/api && npm start",
    "start-map-frontend": "cd packages/map-next && npm run preview:embed",
    "lint": "eslint .",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier . --ignore-unknown --write",
    "format:check": "prettier . --ignore-unknown --check",
    "clean": "lerna exec -- npm run clean",
    "install": "lerna exec -- npm install --legacy-peer-deps",
    "audit": "lerna exec -- npm audit --omit=dev",
    "prepare": "husky",
    "webtests": "start-server-and-test webtests-server http://localhost:3000 webtests-run",
    "webtests:ui": "start-server-and-test webtests-server http://localhost:3000 webtests-run:ui",
    "webtests-server": "NODE_ENV=test npm run dev-legacy",
    "webtests-run": "cd packages/map && npm run webtests",
    "webtests-run:ui": "cd packages/map && npm run webtests:ui"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.15.0+sha512.fa4d2d93b9519e93143e70bb913b94ff2ad5fe69c5a0f84943be557cbb59e9fc1bcce55768fb1313f225f4f9f50c78b8f366f2332aa41effd7b10efa98d8d72f"
}
