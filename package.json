{
  "name": "teikei",
  "version": "1.0.0",
  "description": "Teikei root monorepo. Teikei is the software that powers ernte-teilen.org, a website that maps out Community-supported Agriculture in Germany.",
  "main": "index.js",
  "repository": "https://github.com/teikei/teikei.git",
  "author": "Simon Jockers, Daniel Mack, Tobias Preuß, Christian Rijke",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-query": "^5.100.11",
    "@types/chroma-js": "^3.1.2",
    "@types/react-select": "^5.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lerna": "^9.0.7",
    "lint-staged": "^17.0.5",
    "npm-check-updates": "^22.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "prettier-config-standard": "^7.0.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "standard": "^17.1.2",
    "start-server-and-test": "^3.0.5",
    "svelte": "^5.55.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "optionalDependencies": {
    "@nx/nx-linux-x64-gnu": "^22.7.2"
  },
  "scripts": {
    "dev": "run-p _db:up _stack:map",
    "dev:legacy": "run-p _db:up _stack:legacy",
    "dev:admin": "run-p _db:up _stack:admin",
    "dev:no-db": "run-p _api _map",
    "dev:admin:no-db": "run-p _api _admin",
    "db": "run-p _db:up _db:migrate",
    "build": "lerna exec -- npm run build",
    "start": "NODE_ENV=production run-p _start:api _start:map",
    "lint": "eslint --cache .",
    "lint:check": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "format": "prettier . --ignore-unknown --write",
    "format:check": "prettier . --ignore-unknown --check",
    "webtests": "start-server-and-test _webtests:server http://localhost:3000 _webtests:run",
    "webtests:ui": "start-server-and-test _webtests:server http://localhost:3000 _webtests:run:ui",
    "clean": "lerna exec -- npm run clean",
    "install": "lerna exec -- npm ci --legacy-peer-deps",
    "audit": "lerna exec -- npm audit --omit=dev",
    "prepare": "husky",
    "_db:up": "cd packages/api && npm run dev-db-startdocker",
    "_db:migrate": "cd packages/api && npm run dev-db-initdb",
    "_api": "cd packages/api && npm run dev",
    "_map": "cd packages/map-next && npm run dev | cat",
    "_map:legacy": "cd packages/map && npm run dev | cat",
    "_admin": "cd packages/admin && npm run dev",
    "_app:legacy": "run-p _api _map:legacy",
    "_stack:map": "run-s _db:migrate dev:no-db",
    "_stack:legacy": "run-s _db:migrate _app:legacy",
    "_stack:admin": "run-s _db:migrate dev:admin:no-db",
    "_start:api": "cd packages/api && npm start",
    "_start:map": "cd packages/map-next && npm run preview:embed",
    "_webtests:server": "NODE_ENV=test npm run dev:legacy",
    "_webtests:run": "cd packages/map && npm run webtests",
    "_webtests:run:ui": "cd packages/map && npm run webtests:ui"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.15.0+sha512.fa4d2d93b9519e93143e70bb913b94ff2ad5fe69c5a0f84943be557cbb59e9fc1bcce55768fb1313f225f4f9f50c78b8f366f2332aa41effd7b10efa98d8d72f"
}
